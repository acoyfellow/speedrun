{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "speedrun",
  "main": "src/selfhost.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "speedrun" }],
  "r2_buckets": [{ "binding": "ATTEMPTS", "bucket_name": "speedrun-attempts" }],
  "containers": [{ "class_name": "RunnerContainer", "image": "./container/Dockerfile", "max_instances": 6, "instance_type": "basic" }],
  "durable_objects": {
    "bindings": [
      { "name": "RACE", "class_name": "RaceRoom" },
      { "name": "GOVERNOR", "class_name": "Governor" },
      { "name": "RUNNER", "class_name": "RunnerContainer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaceRoom", "Governor", "RunnerContainer"] }],
  "ratelimits": [
    { "name": "START_LIMIT", "namespace_id": "4101", "simple": { "limit": 3, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } }
  ]
}
