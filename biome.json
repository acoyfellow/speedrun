{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "web/src/**",
      "test/**",
      "container/**",
      "scripts/**",
      "!src/track-files.generated.ts",
      "!**/*.svelte"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "none" } }
}
